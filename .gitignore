# Сборка блоков под Tilda — генерируется из исходников, см. tilda/README.md
tilda/out/*
# Исключения: пульт переноса и картинки под загрузку в Тильду. Пульт самодостаточен
# (код всех блоков внутри), поэтому открывается с GitHub Pages без сборки.
# Это снимок сборки — после правок исходников пересоберите и закоммитьте заново.
!tilda/out/COPY.html
!tilda/out/_upload/

# Кеш хэшей блоков для пульта переноса (out/COPY.html) — локальный, не для репозитория
tilda/.block-hash-cache.json

# Артефакты старой сборки под Tilda — не нужны для GitHub Pages
tilda-*.html
tilda-*.txt
tilda-*.zip
tilda-photo-*.webp
prototype-source.html
build_tilda_vibe.py
COPY-*.cmd
PHOTOS-FOR-TILDA.txt
TILDA-README.md

# Прочее
dbg4_out.txt
.DS_Store
Thumbs.db

# Не используются на странице (фото кейсов убраны в пользу цифр), остаются локально
assets/case-*.png
assets/warehouse.webp

# Прайс-лист: живёт в Google Drive и в Тильде, в репозитории не нужен.
assets/docs/
